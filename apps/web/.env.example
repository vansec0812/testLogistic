# URL backend ECont. Backend phải giữ secret AI trong environment server;
# không thêm API key vào biến VITE_* vì các biến này sẽ đi vào bundle trình duyệt.
# Leave blank for the integrated local gateway (npm run dev / npm run preview).
# Set an absolute backend URL only when deploying a separate API server.
VITE_API_BASE_URL=

# Optional Supabase client configuration for the Online Database page.
# These are public browser-side values; protect the database with Supabase RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_DASHBOARD_URL=

# Backend cần cung cấp các endpoint:
# POST /api/ai/edo/verify
# POST /api/ai/edo/scan (tùy chọn)
# POST /api/ai/container/inspect
# POST /api/ai/container/verify
