PORT=8000
AI_PROVIDER=gemini
# Gemini API key, server-side only. Also accepts GEMINI_API_KEY or GOOGLE_API_KEY.
ECONT_AI_API_KEY=
ECONT_AI_MODEL=gemini-3-flash-preview
# Optional comma-separated fallback models; retries share one timeout budget.
ECONT_AI_FALLBACK_MODELS=gemini-3-flash-preview
ECONT_AI_TIMEOUT_MS=90000
AI_ALLOWED_ORIGIN=http://localhost:5173

# Optional: Gmail SMTP settings used only when Ops sends an RU email.
# Generate an App Password in the Gmail account used as the sender; do not use its login password.
ECONT_SMTP_HOST=smtp.gmail.com
ECONT_SMTP_PORT=465
ECONT_SMTP_SECURE=true
ECONT_SMTP_USER=
ECONT_SMTP_APP_PASSWORD=
ECONT_SMTP_FROM=
# Gmail IMAP replies are polled by Ops while a transaction waits for RU.
# Leave user/password blank to reuse the SMTP sender credentials above.
ECONT_IMAP_HOST=imap.gmail.com
ECONT_IMAP_PORT=993
ECONT_IMAP_SECURE=true
ECONT_IMAP_USER=
ECONT_IMAP_APP_PASSWORD=
# Comma-separated recipient emails/domains allowed for RU mail, e.g. maersk.com,evergreen-marine.com
ECONT_CARRIER_EMAIL_ALLOWLIST=
