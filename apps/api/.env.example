PORT=8000
AI_PROVIDER=gemini
# Gemini API key, server-side only. Also accepts GEMINI_API_KEY or GOOGLE_API_KEY.
ECONT_AI_API_KEY=
ECONT_AI_MODEL=gemini-3-flash-preview
# Optional comma-separated fallback models; retries share one timeout budget.
ECONT_AI_FALLBACK_MODELS=gemini-3-flash-preview
ECONT_AI_TIMEOUT_MS=90000
AI_ALLOWED_ORIGIN=http://localhost:5173
